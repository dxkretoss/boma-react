              "mode": "raw",
              "raw": "{\n  \"action\": \"invite-pod-member\",\n  \"podId\": \"{{podId}}\",\n  \"inviterId\": \"{{userId}}\",\n  \"email\": \"neighbor@example.com\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "3.3 Get Pod Details & Member Status",
          "request": {
            "method": "POST",
