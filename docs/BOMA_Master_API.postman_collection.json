    {
      "name": "2. Onboarding & Readiness Scoring (custom-onboarding)",
      "item": [
        {
          "name": "2.1 Fetch Dynamic Admin-Managed Questionnaire",
          "request": {
            "description": "Fetches the live published questionnaire dynamically configured by BOMA Admins. Returns questions grouped by `step_number` in `steps` array with titles, question types (single_choice, multiple_choice, text, range, number), choices, and total_steps count.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-questionnaire\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.2 Fetch & Resume User Progress",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-progress\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.3 Auto-Save Step (e.g. Age Group)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionnaireId\": \"PASTE_QN_ID\",\n  \"questionnaireVersion\": 1,\n  \"questionId\": \"PASTE_Q_ID\",\n  \"questionKey\": \"age_group\",\n  \"answerJson\": {\n    \"value\": \"25-34\"\n  },\n  \"stepNumber\": 1\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.4 Auto-Save Multiple Choice (e.g. Lifestyles)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionnaireId\": \"PASTE_QN_ID\",\n  \"questionnaireVersion\": 1,\n  \"questionId\": \"PASTE_Q_ID\",\n  \"questionKey\": \"lifestyles\",\n  \"answerJson\": {\n    \"values\": [\"remote-work\", \"sustainability\", \"creative\"]\n  },\n  \"stepNumber\": 2\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.5 Submit Profile & Calculate Readiness Score",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"submit-onboarding\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.6 Get Readiness Score Calculation Breakdown",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-score-breakdown\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        }
      ]
    },
