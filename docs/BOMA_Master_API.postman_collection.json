            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"create-pod\",\n  \"creatorId\": \"{{userId}}\",\n  \"name\": \"The Cedar Grove Pod\",\n  \"description\": \"4 families purchasing property in East Austin\",\n  \"groupType\": \"Friends\",\n  \"housingIntent\": \"Co-develop property\",\n  \"commitmentTimeline\": \"5+ years\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
