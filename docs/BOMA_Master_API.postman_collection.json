            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"submit-pod-review\",\n  \"podId\": \"{{podId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        }
      ]
    },
