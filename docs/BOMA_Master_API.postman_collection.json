  "item": [
    {
      "name": "1. Authentication & Security (custom-auth)",
      "item": [
        {
          "name": "1.1 Register User (Signup)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"register\",\n  \"name\": \"Jordan Rivera\",\n  \"email\": \"jordan@example.com\",\n  \"password\": \"MySecurePassword123!\"\n}"
            },
            "url": { "raw": "{{customAuthUrl}}" }
          }
        },
        {
          "name": "1.2 Verify Email OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"verify-email\",\n  \"email\": \"jordan@example.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": { "raw": "{{customAuthUrl}}" }
          }
        },
        {
          "name": "1.3 Resend Verification Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"resend-verification\",\n  \"email\": \"jordan@example.com\"\n}"
            },
            "url": { "raw": "{{customAuthUrl}}" }
          }
        },
        {
          "name": "1.4 User Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"login\",\n  \"email\": \"jordan@example.com\",\n  \"password\": \"MySecurePassword123!\"\n}"
            },
            "url": { "raw": "{{customAuthUrl}}" }
          }
        },
        {
          "name": "1.5 Request Password Reset (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"request-password-reset\",\n  \"email\": \"jordan@example.com\"\n}"
