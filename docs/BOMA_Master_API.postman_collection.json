  "item": [
    {
      "name": "1. Authentication & Security (custom-auth)",
      "item": [
        {
          "name": "1.1 Register User (Signup)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
