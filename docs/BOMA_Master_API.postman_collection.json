    {
      "name": "2. Onboarding Flow (Matching Pool)",
      "item": [
        {
          "name": "2.1 Fetch Dynamic Admin-Managed Questionnaire",
          "request": {
            "description": "Fetches the live published questionnaire dynamically configured by BOMA Admins. Returns questions grouped by `step_number` in `steps` array with titles, question types (single_choice, multiple_choice, text, range, number), choices, and total_steps count.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-questionnaire\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.2 Fetch & Resume User Progress",
          "request": {
            "description": "Fetches the user's current onboarding step and all previously saved responses from Supabase database.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-progress\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.3 Step 1 - Save Demographics (Age Group)",
          "request": {
            "description": "Saves Step 1 age tier in 1 API call (options: '18–30 years', '31–60 years', '61+ years').",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"stepNumber\": 1,\n  \"responses\": [\n    {\n      \"questionKey\": \"age_group\",\n      \"answerJson\": { \"value\": \"31–60 years\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.4 Step 2 - Save Lifestyle Values",
          "request": {
            "description": "Saves Step 2 multiple-choice lifestyle values in 1 API call (options: 'Quiet & low-key', 'Eco-conscious', 'Shared meals', 'Pet-friendly', 'Remote work', 'Community garden').",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"stepNumber\": 2,\n  \"responses\": [\n    {\n      \"questionKey\": \"lifestyles\",\n      \"answerJson\": { \"values\": [\"Quiet & low-key\", \"Pet-friendly\"] }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.5 Step 3 - Save Community Preferences (Decision Style & Pod Size in 1 Call)",
          "request": {
            "description": "Saves all Step 3 questions (Decision Style + Pod Size) simultaneously in 1 single API call.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"stepNumber\": 3,\n  \"responses\": [\n    {\n      \"questionKey\": \"decision_style\",\n      \"answerJson\": { \"value\": \"consensus\" }\n    },\n    {\n      \"questionKey\": \"pod_size\",\n      \"answerJson\": { \"value\": \"7–10 households\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.6 Step 4 - Save Location Bounds (City, Radius & Setting in 1 Call)",
          "request": {
            "description": "Saves all Step 4 location questions (City + Search Radius + Setting Preference) simultaneously in 1 single API call.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"stepNumber\": 4,\n  \"responses\": [\n    {\n      \"questionKey\": \"location_city\",\n      \"answerJson\": { \"value\": \"Atlanta, GA\" }\n    },\n    {\n      \"questionKey\": \"location_radius\",\n      \"answerJson\": { \"value\": \"45\" }\n    },\n    {\n      \"questionKey\": \"setting_preference\",\n      \"answerJson\": { \"value\": \"urban\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.7 Step 5 - Save Budget & Financing (Budget, Down Payment & Financing in 1 Call)",
          "request": {
            "description": "Saves all Step 5 financial questions (Purchase Budget + Down Payment Tier + Financing Preference) simultaneously in 1 single API call.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"stepNumber\": 5,\n  \"responses\": [\n    {\n      \"questionKey\": \"budget_range\",\n      \"answerJson\": { \"value\": \"$350,000 – $450,000\" }\n    },\n    {\n      \"questionKey\": \"down_payment_tier\",\n      \"answerJson\": { \"value\": \"5–10%\" }\n    },\n    {\n      \"questionKey\": \"financing_preference\",\n      \"answerJson\": { \"value\": \"traditional mortgage\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.8 Step 6 - Save Primary Housing Intent",
          "request": {
            "description": "Saves Step 6 primary housing intent in 1 API call (options: 'purchase', 'co-develop', 'investment', 'co-living').",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"stepNumber\": 6,\n  \"responses\": [\n    {\n      \"questionKey\": \"housing_intent\",\n      \"answerJson\": { \"value\": \"purchase\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.9 Step 7 - Save Commitment Duration",
          "request": {
            "description": "Saves Step 7 minimum commitment timeline in 1 API call (options: '2+ years', '5+ years', 'flexible').",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"stepNumber\": 7,\n  \"responses\": [\n    {\n      \"questionKey\": \"commitment_timeline\",\n      \"answerJson\": { \"value\": \"2+ years\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.10 Submit Onboarding & Compute Readiness Score",
          "request": {
            "description": "Submits final profile responses, sets status to UNDER_REVIEW, and automatically calculates the user's Readiness Score using active scoring rules.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"submit-onboarding\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.11 Get Score Calculation Breakdown",
          "request": {
            "description": "Fetches category score breakdown (budget, intent, commitment, community) and total Readiness Score.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-score-breakdown\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        }
      ]
    },
    {
      "name": "3. Existing Pod Formation & Invites (custom-onboarding)",
      "item": [
        {
          "name": "3.1 Create Existing Pod",
          "request": {
            "method": "POST",
