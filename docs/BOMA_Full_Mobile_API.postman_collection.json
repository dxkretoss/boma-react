    {
      "name": "2. Onboarding Flow (Matching Pool)",
      "item": [
        {
          "name": "2.1 Fetch Dynamic Admin-Managed Questionnaire",
          "request": {
            "description": "Fetches the live published questionnaire dynamically configured by BOMA Admins. Returns questions grouped by `step_number` in `steps` array with titles, question types (single_choice, multiple_choice, text, range, number), choices, and total_steps count.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-questionnaire\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.2 Fetch & Resume User Progress",
          "request": {
            "description": "Fetches the user's current onboarding step and all previously saved responses from Supabase database.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-progress\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.3 Step 1 - Save Age Group",
          "request": {
            "description": "Saves Step 1 age tier response (options: '18–30 years', '31–60 years', '61+ years').",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionKey\": \"age_group\",\n  \"stepNumber\": 1,\n  \"answerJson\": {\n    \"value\": \"31–60 years\"\n  }\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.4 Step 2 - Save Lifestyle Values",
          "request": {
            "description": "Saves Step 2 multiple-choice lifestyle values (options: 'Quiet & low-key', 'Eco-conscious', 'Shared meals', 'Pet-friendly', 'Remote work', 'Community garden').",
