            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionKey\": \"lifestyles\",\n  \"stepNumber\": 2,\n  \"answerJson\": {\n    \"values\": [\"Quiet & low-key\", \"Pet-friendly\"]\n  }\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "2.5 Step 3 - Save Decision Style",
          "request": {
            "description": "Saves Step 3 decision making style (options: 'consensus', 'delegated', 'flexible').",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
