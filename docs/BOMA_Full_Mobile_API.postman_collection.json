            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionKey\": \"financing_preference\",\n  \"stepNumber\": 5,\n  \"answerJson\": {\n    \"value\": \"traditional mortgage\"\n  }\n}"
