            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionKey\": \"decision_style\",\n  \"stepNumber\": 3,\n  \"answerJson\": {\n    \"value\": \"consensus\"\n  }\n}"
