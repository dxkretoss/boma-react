              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionKey\": \"down_payment_tier\",\n  \"stepNumber\": 5,\n  \"answerJson\": {\n    \"value\": \"5–10%\"\n  }\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
