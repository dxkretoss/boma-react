  "item": [
    {
      "name": "1. Authentication & Password Reset",
      "item": [
        {
          "name": "1.1 Register User (Signup)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"register\",\n  \"name\": \"Alex Mercer\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{customAuthUrl}}" }
          }
        },
        {
          "name": "1.2 Verify Email OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
