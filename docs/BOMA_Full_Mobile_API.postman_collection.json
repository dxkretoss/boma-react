          "request": {
            "description": "Saves Step 6 primary housing intent (options: 'purchase', 'co-develop', 'investment', 'co-living').",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionKey\": \"housing_intent\",\n  \"stepNumber\": 6,\n  \"answerJson\": {\n    \"value\": \"purchase\"\n  }\n}"
