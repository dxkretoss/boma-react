              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"save-response\",\n  \"userId\": \"{{userId}}\",\n  \"questionKey\": \"location_radius\",\n  \"stepNumber\": 4,\n  \"answerJson\": {\n    \"value\": \"45\"\n  }\n}"
