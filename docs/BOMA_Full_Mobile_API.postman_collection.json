    {
      "name": "3. Register Existing Pod Flow",
      "item": [
        {
          "name": "3.1 Create Existing Pod",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"create-pod\",\n  \"creatorId\": \"{{userId}}\",\n  \"name\": \"The Fourplex Founders\",\n  \"description\": \"4 friends buying a fourplex in East Austin\",\n  \"groupType\": \"Friends\",\n  \"housingIntent\": \"Co-develop property\",\n  \"commitmentTimeline\": \"5+ years\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "3.2 Invite Pod Member via Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"invite-pod-member\",\n  \"podId\": \"{{podId}}\",\n  \"inviterId\": \"{{userId}}\",\n  \"email\": \"friend@example.com\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "3.3 Get Pod Details & Member Roster",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"get-pod-details\",\n  \"podId\": \"{{podId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        },
        {
          "name": "3.4 Submit Pod for Admin Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anonKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"submit-pod-review\",\n  \"podId\": \"{{podId}}\"\n}"
            },
            "url": { "raw": "{{customOnboardingUrl}}" }
          }
        }
      ]
    },
