{
  "info": {
    "_postman_id": "boma-custom-auth-collection-v2",
    "name": "BOMA — Full API Collection (Auth, OTP & Pods)",
    "description": "Unified API collection for BOMA Web & Mobile apps including Custom Auth, 2-Step OTP Password Reset, and Pod Invitation flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "customAuthUrl",
      "value": "https://uasdswkgodhczlbqkira.supabase.co/functions/v1/custom-auth",
      "type": "string"
    },
    {
      "key": "sendEmailUrl",
      "value": "https://uasdswkgodhczlbqkira.supabase.co/functions/v1/send-verification-email",
      "type": "string"
    },
    {
      "key": "anonKey",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVhc2Rzd2tnb2RoY3psYnFraXJhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY1Mjc0MTMsImV4cCI6MjEwMjEwMzQxM30.ejdIeWoWHBg1En2PdGXj00rAm540P1iBpBz9-NykXGI",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{anonKey}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({key: 'apikey', value: pm.variables.get('anonKey')});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register User (Signup)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"register\",\n  \"name\": \"Alex Mercer\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{customAuthUrl}}",
          "host": [
            "{{customAuthUrl}}"
          ]
        },
        "description": "Registers a new user in the custom users table, generates a 6-digit OTP code, and sends a verification email."
      },
      "response": []
    },
    {
      "name": "2. Verify Email OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"verify-email\",\n  \"email\": \"alex@example.com\",\n  \"code\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{customAuthUrl}}",
          "host": [
            "{{customAuthUrl}}"
          ]
        },
        "description": "Verifies the 6-digit email code and activates the account."
      },
      "response": []
    },
    {
      "name": "3. Resend Verification Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"resend-verification\",\n  \"email\": \"alex@example.com\"\n}"
        },
        "url": {
          "raw": "{{customAuthUrl}}",
          "host": [
            "{{customAuthUrl}}"
          ]
        },
        "description": "Generates a new 6-digit code and resends the verification email."
      },
      "response": []
    },
    {
      "name": "4. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"login\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{customAuthUrl}}",
          "host": [
            "{{customAuthUrl}}"
          ]
        },
        "description": "Authenticates user against bcrypt-hashed password and returns user profile."
      },
      "response": []
    },
    {
      "name": "5. Request Password Reset (Send OTP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"request-password-reset\",\n  \"email\": \"alex@example.com\"\n}"
        },
        "url": {
          "raw": "{{customAuthUrl}}",
          "host": [
            "{{customAuthUrl}}"
          ]
        },
        "description": "Generates a 6-digit OTP code stored in users.verification_code and emails it to the user."
      },
      "response": []
    },
    {
      "name": "6. Verify Password Reset OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"verify-reset-otp\",\n  \"email\": \"alex@example.com\",\n  \"token\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{customAuthUrl}}",
          "host": [
            "{{customAuthUrl}}"
          ]
        },
        "description": "Verifies that the 6-digit OTP code entered by the user matches before allowing navigation to the Set New Password screen."
      },
      "response": []
    },
    {
      "name": "7. Set New Password (Reset Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"reset-password\",\n  \"email\": \"alex@example.com\",\n  \"token\": \"123456\",\n  \"newPassword\": \"NewSecurePassword123!\"\n}"
        },
        "url": {
          "raw": "{{customAuthUrl}}",
          "host": [
            "{{customAuthUrl}}"
          ]
        },
        "description": "Validates the 6-digit OTP code from the email, bcrypt-hashes newPassword, and updates users.password."
      },
      "response": []
    },
    {
      "name": "8. Update Onboarding State",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"update-onboarding\",\n  \"userId\": \"PASTE_USER_UUID_HERE\",\n  \"onboardingData\": {\n    \"ageGroup\": \"25-34\",\n    \"selectedLifestyles\": [\"remote-work\", \"sustainability\"],\n    \"decisionStyle\": \"consensus\",\n    \"podSize\": \"3-5\",\n    \"locationCity\": \"Austin, TX\",\n    \"locationRadius\": \"25 miles\",\n    \"settingPreference\": \"suburban\",\n    \"budgetRange\": \"$200k-$400k\",\n    \"downPaymentTier\": \"10-20%\",\n    \"financingPreference\": \"traditional-mortgage\",\n    \"housingIntent\": \"purchase\",\n    \"commitmentTimeline\": \"timeline_5yr\",\n    \"readinessScore\": 85\n  }\n}"
        },
        "url": {
          "raw": "{{customAuthUrl}}",
          "host": [
            "{{customAuthUrl}}"
          ]
        },
        "description": "Updates user onboarding responses and marks user_onboarded as true."
      },
      "response": []
    },
    {
      "name": "9. Send Pod Invitation Email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"friend@example.com\",\n  \"type\": \"invitation\",\n  \"podName\": \"The Fourplex Founders\",\n  \"inviterName\": \"Alex Mercer\",\n  \"inviteUrl\": \"http://localhost:5173/join-pod?token=SAMPLE_TOKEN_HERE\"\n}"
        },
        "url": {
          "raw": "{{sendEmailUrl}}",
          "host": [
            "{{sendEmailUrl}}"
          ]
        },
        "description": "Invokes the send-verification-email Edge Function to dispatch an email invitation to join a Pod."
      },
      "response": []
    }
  ]
}
