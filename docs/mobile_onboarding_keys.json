              "values": [
                "Quiet & low-key",
                "Pet-friendly"
              ]
            }
          }
        }
      ]
    },
    {
      "step_number": 3,
      "step_name": "Community Preferences & Group Size",
      "fields": [
        {
          "question_key": "decision_style",
          "data_type": "string",
          "question_type": "single_choice",
          "is_required": true,
          "allowed_values": [
            "consensus",
            "delegated",
            "flexible"
          ],
          "answer_json_structure": {
            "value": "consensus"
